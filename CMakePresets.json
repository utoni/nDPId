{
  "version": 2,
  "configurePresets": [
    {
      "name": "unix",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "minimal-unix",
      "inherits": "unix",
      "binaryDir": "${sourceDir}/build-minimal",
      "cacheVariables": {
        "BUILD_NDPI": "ON"
      }
    },
    {
      "name": "default-unix",
      "inherits": "minimal-unix",
      "binaryDir": "${sourceDir}/build-default",
      "cacheVariables": {
        "BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "all-unix",
      "inherits": "default-unix",
      "binaryDir": "${sourceDir}/build-all",
      "cacheVariables": {
        "BUILD_RUST_EXAMPLES": "ON",
        "ENABLE_CONNTRACK": "ON",
        "ENABLE_CRYPTO": "ON",
        "ENABLE_CURL": "ON",
        "ENABLE_DBUS": "ON",
        "ENABLE_SYSTEMD": "ON",
        "ENABLE_ZLIB": "ON"
      }
    },
    {
      "name": "all-unix-local-ndpi",
      "inherits": "all-unix",
      "binaryDir": "${sourceDir}/build-all-local-ndpi",
      "cacheVariables": {
        "BUILD_NDPI": "OFF",
        "NDPI_WITH_GCRYPT": "ON",
        "NDPI_WITH_MAXMINDDB": "ON",
        "NDPI_WITH_PCRE": "ON",
        "NDPI_WITH_PLUGIN_SYSTEM": "ON"
      }
    },
    {
      "name": "all-unix-asan",
      "inherits": "all-unix",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "ENABLE_SANITIZER": "ON"
      }
    },
    {
      "name": "all-unix-tsan",
      "inherits": "all-unix",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "ENABLE_SANITIZER_THREAD": "ON"
      }
    },
    {
      "name": "all-unix-profiler",
      "inherits": "all-unix",
      "binaryDir": "${sourceDir}/build-memprof",
      "cacheVariables": {
        "ENABLE_MEMORY_STATUS": "ON",
        "ENABLE_MEMORY_PROFILING": "ON"
      }
    }
  ]
}
